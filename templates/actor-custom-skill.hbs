<div class="fnri-entry fnri-skill-row fnri-custom-skill-row" data-fnri-skill-entry data-skill-row="{{this.id}}" data-fnri-dice-assigned="{{#if this.hasDice}}true{{else}}false{{/if}}">
  <div class="fnri-skill-cell"><span class="fnri-skill-read-only">{{this.name}}</span><div class="fnri-skill-edit-only"><input type="text" data-row-collection="skills" data-row-id="{{this.id}}" data-row-field="name" value="{{this.name}}" aria-label="{{localize 'FASTNRI.Fields.name'}}">
  {{#if this.isSpecialization}}<select data-row-collection="skills" data-row-id="{{this.id}}" data-row-field="group" aria-label="{{localize 'FASTNRI.SkillAllocation.specializationGroup'}}"><option value="" {{#unless this.hasSkillGroup}}selected{{/unless}}>{{localize "FASTNRI.SkillAllocation.noGroup"}}</option>{{#each this.specializationGroups}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}</select>{{/if}}
  {{#unless @root.pcSkillView}}<select data-row-collection="skills" data-row-id="{{this.id}}" data-row-field="kind" aria-label="{{localize 'FASTNRI.Fields.checkKind'}}"><option value="skill" {{#if this.isSkill}}selected{{/if}}>{{localize "FASTNRI.Fields.skill"}}</option><option value="specialization" {{#if this.isSpecialization}}selected{{/if}}>{{localize "FASTNRI.Fields.specialization"}}</option></select>{{/unless}}
  </div></div>
  <div class="fnri-skill-cell"><strong class="fnri-skill-read-only">{{#if this.effectiveDice}}{{this.effectiveDice}}{{else}}—{{/if}}</strong><div class="fnri-skill-edit-only">
  <select data-fnri-dice-picker="{{this.diceKind}}" data-fnri-single-dice data-row-id="{{this.id}}" aria-label="{{localize 'FASTNRI.Fields.dice'}}">{{#each this.diceOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
  <input type="text" class="fnri-custom-dice" data-fnri-custom-dice data-row-collection="skills" data-row-id="{{this.id}}" data-row-field="dice" value="{{this.dice}}" aria-label="{{localize 'FASTNRI.Fields.customDice'}}" {{#unless this.hasCustomDice}}hidden{{/unless}}>{{#if this.hasEffectiveDice}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{this.effectiveDice}}</small>{{/if}}</div></div>
  <div class="fnri-skill-cell"><span class="fnri-skill-read-only">{{this.effectiveModifier}}</span><div class="fnri-skill-edit-only"><input class="fnri-number" type="text" inputmode="decimal" data-row-collection="skills" data-row-id="{{this.id}}" data-row-field="modifier" value="{{this.modifier}}" aria-label="{{localize 'FASTNRI.Fields.checkModifier'}}">{{#if this.hasEffectiveModifier}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{this.effectiveModifier}}</small>{{/if}}</div></div>
  <div class="fnri-skill-row-actions"><button type="button" data-action="rollSkill" data-id="{{this.id}}" title="{{localize 'FASTNRI.Actions.rollSkill'}}"><i class="fa-solid fa-dice-d20"></i></button>{{#if @root.editable}}<button type="button" data-action="removeSkill" data-id="{{this.id}}" title="{{localize 'FASTNRI.Actions.removeSkill'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</div>
  {{#if this.hasLegacyValue}}<label class="fnri-legacy-field fnri-skill-edit-only">{{localize "FASTNRI.Fields.legacySkillValue"}}<input type="text" class="fnri-number" inputmode="decimal" data-row-collection="skills" data-row-id="{{this.id}}" data-row-field="value" value="{{this.value}}"></label>{{/if}}
</div>
