<div class="fnri-entry fnri-skill-row fnri-core-skill-row" data-fnri-skill-entry data-skill-row="{{this.id}}" data-fnri-dice-assigned="{{#if this.hasDice}}true{{else}}false{{/if}}">
  <span class="fnri-core-skill-name">{{#if this.namedActions}}<button type="button" class="fnri-skill-actions-toggle" data-action="toggleSkillActions" data-id="{{this.id}}" title="{{this.description}}" aria-expanded="{{#if this.actionsExpanded}}true{{else}}false{{/if}}">{{this.name}}</button>{{else}}<span title="{{this.description}}">{{this.name}}</span>{{/if}}
    {{#if this.pool.source}}<small class="fnri-skill-edit-only">{{this.pool.source}}</small>{{/if}}</span>
  <div class="fnri-skill-cell"><strong class="fnri-skill-read-only">{{#if this.effectiveDice}}{{this.effectiveDice}}{{else}}—{{/if}}</strong>
  <div class="fnri-skill-edit-only">{{#if this.pool}}{{{this.pool.markup}}}
  <input type="text" data-skill-formula="{{this.pool.skill}}" value="{{this.pool.formula}}" aria-label="{{localize 'FASTNRI.Fields.customDice'}}" {{#unless this.formulaOpen}}hidden{{/unless}}>
  {{else}}<select data-fnri-dice-picker="skill" data-row-id="{{this.id}}" aria-label="{{localize 'FASTNRI.Fields.dice'}}">{{#each this.skillDiceOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
  <input type="text" class="fnri-custom-dice" data-fnri-custom-dice data-row-collection="skills" data-row-id="{{this.id}}" data-row-field="dice" value="{{this.dice}}" aria-label="{{localize 'FASTNRI.Fields.customDice'}}" {{#unless this.hasCustomDice}}hidden{{/unless}}>{{/if}}{{#if this.hasEffectiveDice}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{this.effectiveDice}}</small>{{/if}}</div></div>
  <div class="fnri-skill-cell"><span class="fnri-skill-read-only">{{this.effectiveModifier}}</span><div class="fnri-skill-edit-only"><input class="fnri-number" type="text" inputmode="decimal" data-row-collection="skills" data-row-id="{{this.id}}" data-row-field="modifier" value="{{this.modifier}}" aria-label="{{localize 'FASTNRI.Fields.checkModifier'}}">{{#if this.hasEffectiveModifier}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{this.effectiveModifier}}</small>{{/if}}</div></div>
  <button type="button" data-action="rollSkill" data-id="{{this.id}}" title="{{localize 'FASTNRI.Actions.rollSkill'}}"><i class="fa-solid fa-dice-d20"></i></button>
  {{#if this.namedActions}}<ul class="fnri-sheet-actions fnri-skill-actions" data-fnri-skill-actions {{#unless this.actionsExpanded}}hidden{{/unless}}>{{#each this.namedActions}}{{> fnri-actor-standard-action}}{{/each}}</ul>{{/if}}
</div>
