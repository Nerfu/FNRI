<div class="fnri-entry fnri-skill-row fnri-core-skill-row" data-fnri-skill-entry data-skill-row="{{this.id}}">
  <span class="fnri-core-skill-name">{{#if this.namedActions}}<button type="button" class="fnri-skill-actions-toggle" data-action="toggleSkillActions" data-id="{{this.id}}" title="{{this.description}}" aria-expanded="{{#if this.actionsExpanded}}true{{else}}false{{/if}}">{{this.name}}</button>{{else}}<span title="{{this.description}}">{{this.name}}</span>{{/if}}
</span>
  <div class="fnri-skill-cell fnri-formula-cell"><div class="fnri-skill-read-only"><span class="fnri-formula-face" title="{{this.displayFormula.hint}}"><span class="fnri-formula-base {{this.displayFormula.direction}}">{{this.displayFormula.arrow}}{{#if this.displayFormula.arrow}} {{/if}}{{this.displayFormula.base}}</span><span class="fnri-formula-suffix">{{this.displayFormula.suffix}}</span>{{#if this.pool.restricted}}<span class="fnri-skill-restricted" title="{{localize 'FASTNRI.SkillAllocation.restricted'}}">⚠</span>{{/if}}</span></div><div class="fnri-skill-edit-only">{{#if this.pool}}<div class="fnri-skill-nominal"><div class="fnri-formula-picker" title="{{this.displayFormula.hint}}"><span class="fnri-formula-face" title="{{this.displayFormula.hint}}"><span class="fnri-formula-base {{this.displayFormula.direction}}">{{this.displayFormula.arrow}}{{#if this.displayFormula.arrow}} {{/if}}{{this.displayFormula.base}}</span><span class="fnri-formula-suffix">{{this.displayFormula.suffix}}</span></span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i>{{#if this.pool.restricted}}<span class="fnri-skill-restricted" title="{{localize 'FASTNRI.SkillAllocation.restricted'}}">⚠</span>{{/if}}{{{this.pool.markup}}}</div>{{#if this.pool.removable}}<button type="button" data-skill-release title="{{localize 'FASTNRI.SkillAllocation.release'}}" aria-label="{{localize 'FASTNRI.SkillAllocation.release'}}">×</button>{{/if}}</div>
  {{#if this.pool.manualAllowed}}<div class="fnri-skill-manual-editor" data-skill-manual-editor {{#unless this.formulaOpen}}hidden{{/unless}}><label>{{localize 'FASTNRI.Fields.customDice'}}<input type="text" data-skill-formula="{{this.pool.skill}}" value="{{this.pool.formula}}" aria-label="{{localize 'FASTNRI.Fields.customDice'}}"></label><label>{{localize 'FASTNRI.Fields.checkModifier'}}<input class="fnri-number" type="text" inputmode="decimal" data-row-collection="skills" data-row-id="{{this.id}}" data-row-field="modifier" value="{{this.modifier}}" aria-label="{{localize 'FASTNRI.Fields.checkModifier'}}"></label>{{#if this.pool.manual}}<button type="button" data-skill-use-assigned="{{this.pool.skill}}">{{localize "FASTNRI.SkillAllocation.useAssigned"}}</button>{{/if}}</div>{{/if}}
  {{else}}<div class="fnri-skill-nominal"><div class="fnri-formula-picker" title="{{this.displayFormula.hint}}"><span class="fnri-formula-face" title="{{this.displayFormula.hint}}"><span class="fnri-formula-base {{this.displayFormula.direction}}">{{this.displayFormula.arrow}}{{#if this.displayFormula.arrow}} {{/if}}{{this.displayFormula.base}}</span><span class="fnri-formula-suffix">{{this.displayFormula.suffix}}</span></span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i><select data-fnri-dice-picker="{{this.diceKind}}" data-fnri-single-dice data-row-id="{{this.id}}" aria-label="{{localize 'FASTNRI.Fields.dice'}}">{{#each this.diceOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}} {{#if this.disabled}}disabled{{/if}}>{{this.label}}</option>{{/each}}</select></div>{{#if this.hasStoredDice}}<button type="button" data-skill-release title="{{localize 'FASTNRI.SkillAllocation.release'}}" aria-label="{{localize 'FASTNRI.SkillAllocation.release'}}">×</button>{{/if}}</div><div class="fnri-skill-manual-editor" data-skill-manual-editor {{#unless this.manualOpen}}hidden{{/unless}}><label>{{localize 'FASTNRI.Fields.customDice'}}<input type="text" class="fnri-custom-dice" data-fnri-custom-dice data-row-collection="skills" data-row-id="{{this.id}}" data-row-field="dice" value="{{this.dice}}" aria-label="{{localize 'FASTNRI.Fields.customDice'}}"></label>{{#if this.manualAllowed}}<label>{{localize 'FASTNRI.Fields.checkModifier'}}<input class="fnri-number" type="text" inputmode="decimal" data-row-collection="skills" data-row-id="{{this.id}}" data-row-field="modifier" value="{{this.modifier}}" aria-label="{{localize 'FASTNRI.Fields.checkModifier'}}"></label>{{/if}}</div>{{/if}}</div></div>
  <button type="button" data-action="rollSkill" data-id="{{this.id}}" title="{{localize 'FASTNRI.Actions.rollSkill'}}"><i class="fa-solid fa-dice-d20"></i></button>
  {{#if this.namedActions}}<ul class="fnri-sheet-actions fnri-skill-actions" data-fnri-skill-actions {{#unless this.actionsExpanded}}hidden{{/unless}}>{{#each this.namedActions}}{{> fnri-actor-standard-action}}{{/each}}</ul>{{/if}}
</div>
