{{#if projectionSheet}}
<section class="fnri-body fnri-projection-sheet">
  <header class="fnri-projection-heading">
    <img class="fnri-portrait" src="{{actor.img}}" alt="">
    <div class="fnri-heading-fields">
      <label>{{localize "FASTNRI.Fields.name"}}<input type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label>
      <small>{{localize "FASTNRI.Projection.actorKind"}}</small>
    </div>
  </header>
  <section class="fnri-panel fnri-projection-owner">
    <h3>{{localize "FASTNRI.Projection.owner"}}</h3>
    {{#if projectionOwner}}
      <button type="button" data-action="openProjectionOwner"><i class="fa-solid fa-user-link"></i> {{projectionOwner.name}} <i class="fa-solid fa-arrow-up-right-from-square"></i></button>
    {{else}}<p class="fnri-muted">{{localize "FASTNRI.Projection.unlinked"}}</p>{{/if}}
  </section>
  <div class="fnri-projection-stats">
    <section class="fnri-panel">
      <h3>HP</h3>
      <div class="fnri-grid-2">
        <label>{{localize "FASTNRI.Fields.hpCurrent"}}<input class="fnri-number" name="system.hp.current" type="number" data-dtype="Number" data-integer="true" value="{{system.hp.current}}" {{#unless editable}}disabled{{/unless}}></label>
        <label>{{localize "FASTNRI.Fields.hpMax"}}<input class="fnri-number" name="system.hp.max" type="number" data-dtype="Number" data-integer="true" value="{{system.hp.max}}" {{#unless editable}}disabled{{/unless}}></label>
      </div>
      <small class="fnri-muted">{{localize "FASTNRI.Projection.tokenHpHint"}}</small>
    </section>
    <section class="fnri-panel">
      <h3>{{localize "FASTNRI.Fields.acShort"}}</h3>
      <strong>{{projectionAc}}</strong>
      <small class="fnri-muted">{{localize "FASTNRI.Projection.acHint"}}</small>
    </section>
  </div>
  <section class="fnri-panel">
    <h3>{{localize "FASTNRI.Sections.description"}}</h3>
    <textarea name="system.description" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>
  </section>
  <button type="button" data-action="toggleProjectionFull" class="fnri-projection-full"><i class="fa-solid fa-gear"></i> {{localize "FASTNRI.Projection.fullSheet"}}</button>
  <span class="fnri-save-indicator" data-fnri-save-state role="status" aria-live="polite">{{localize "FASTNRI.Save.saved"}}</span>
</section>
{{else}}
<section class="fnri-body fnri-actor-body">
<div class="fnri-persistent">
  <header class="fnri-summary-heading">
    <img class="fnri-portrait" src="{{actor.img}}" alt="">
    <div class="fnri-summary-identity">
      <strong class="fnri-summary-name">{{actor.name}}</strong>
      <small>{{#if system.role}}{{system.role}}{{/if}}{{#if system.rank}} · {{system.rank}}{{/if}}</small>
    </div>
    <span class="fnri-save-indicator" data-fnri-save-state role="status" aria-live="polite">{{localize "FASTNRI.Save.saved"}}</span>
  </header>
  <div class="fnri-summary-stats">
    <div class="fnri-summary-stat" title="{{localize 'FASTNRI.Fields.hpCurrent'}} / {{localize 'FASTNRI.Fields.hpMax'}}">
      {{#if editable}}<button type="button" class="fnri-hp-trigger" data-action="toggleQuickHp" aria-label="{{localize 'FASTNRI.Actions.editHp'}}" aria-expanded="{{#if quickHpOpen}}true{{else}}false{{/if}}">{{/if}}
      <span>HP</span><strong>{{summary.hp}}</strong>{{#if summary.tempHP}}<small>({{summary.tempHP}})</small>{{/if}}
      {{#if editable}}</button>{{/if}}
    </div>
    <div class="fnri-summary-stat" title="{{localize 'FASTNRI.Fields.partial'}} / {{localize 'FASTNRI.Fields.success'}} / {{localize 'FASTNRI.Fields.great'}}"><span>{{localize "FASTNRI.Fields.acShort"}}</span><strong>{{summary.ac}}</strong></div>
    <div class="fnri-summary-stat"><span>{{localize "FASTNRI.Fields.attackModifier"}}</span><strong>{{summary.attackModifier}}</strong></div>
    <div class="fnri-summary-stat"><span>{{localize "FASTNRI.Fields.speed"}}</span><strong>{{summary.speed}}</strong></div>
  </div>
  {{#if editable}}<div class="fnri-quick-hp" data-fnri-quick-hp {{#unless quickHpOpen}}hidden{{/unless}}>
    <label>{{localize "FASTNRI.Fields.hpCurrent"}}<input class="fnri-number" type="text" inputmode="decimal" data-dtype="Number" data-integer="true" name="system.hp.current" value="{{system.hp.current}}"></label>
    <label>{{localize "FASTNRI.Fields.hpTemp"}}<input class="fnri-number" type="text" inputmode="decimal" data-dtype="Number" data-integer="true" name="system.hp.temp" value="{{system.hp.temp}}"></label>
  </div>{{/if}}
</div>
<nav class="fnri-tabs" aria-label="{{localize 'FASTNRI.Sections.tabs'}}">
<button type="button" data-action="fnriSwitchTab" data-fnri-target="characteristics" class="fnri-tab {{#if tabs.characteristics}}active{{/if}}" {{#if tabs.characteristics}}aria-current="page"{{/if}}>{{localize "FASTNRI.Tabs.characteristics"}}</button>
  <button type="button" data-action="fnriSwitchTab" data-fnri-target="actions" class="fnri-tab {{#if tabs.actions}}active{{/if}}" {{#if tabs.actions}}aria-current="page"{{/if}}>{{localize "FASTNRI.Tabs.actions"}}</button>
<button type="button" data-action="fnriSwitchTab" data-fnri-target="skills" class="fnri-tab {{#if tabs.skills}}active{{/if}}" {{#if tabs.skills}}aria-current="page"{{/if}}>{{localize "FASTNRI.Tabs.skills"}}</button>
<button type="button" data-action="fnriSwitchTab" data-fnri-target="abilities" class="fnri-tab {{#if tabs.abilities}}active{{/if}}" {{#if tabs.abilities}}aria-current="page"{{/if}}>{{localize "FASTNRI.Tabs.abilities"}}</button>
<button type="button" data-action="fnriSwitchTab" data-fnri-target="inventory" class="fnri-tab {{#if tabs.inventory}}active{{/if}}" {{#if tabs.inventory}}aria-current="page"{{/if}}>{{localize "FASTNRI.Tabs.inventory"}}</button>
<button type="button" data-action="fnriSwitchTab" data-fnri-target="description" class="fnri-tab {{#if tabs.description}}active{{/if}}" {{#if tabs.description}}aria-current="page"{{/if}}>{{localize "FASTNRI.Tabs.description"}}</button>
</nav>
<div class="fnri-tab-content" data-fnri-panel="characteristics" {{#unless tabs.characteristics}}hidden{{/unless}}><details class="fnri-panel fnri-collapsible" data-fnri-section="identity" {{#if sections.identity}}open{{/if}}><summary>{{localize "FASTNRI.Sections.characteristics"}}</summary>
  
  <div class="fnri-form-grid fnri-identity-grid">
<label>{{localize "FASTNRI.Fields.name"}}<input type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label>
<label>{{localize "FASTNRI.Fields.rank"}}<input type="text" name="system.rank" value="{{system.rank}}" {{#unless editable}}disabled{{/unless}}></label>
<label>{{localize "FASTNRI.Fields.role"}}<input type="text" name="system.role" value="{{system.role}}" {{#unless editable}}disabled{{/unless}}></label>
<label>{{localize "FASTNRI.Fields.weight"}}<input class="fnri-number" type="text" data-dtype="Number" inputmode="decimal" name="system.weight" value="{{system.weight}}" {{#unless editable}}disabled{{/unless}}></label>
</div>
</details>
<details class="fnri-panel fnri-collapsible" data-fnri-section="parameters" {{#if sections.parameters}}open{{/if}}><summary>{{localize "FASTNRI.Sections.parameters"}}</summary>
  
  <div class="fnri-grid-3"><label>{{localize "FASTNRI.Fields.hpCurrent"}}<input class="fnri-number" type="text" data-dtype="Number" data-integer="true" inputmode="decimal" name="system.hp.current" value="{{system.hp.current}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.hp.current}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.hp.current}}</small>{{/if}}</label>
<label>{{localize "FASTNRI.Fields.hpMax"}}<input class="fnri-number" type="text" data-dtype="Number" data-integer="true" inputmode="decimal" name="system.hp.max" value="{{system.hp.max}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.hp.max}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.hp.max}}</small>{{/if}}</label>
<label>{{localize "FASTNRI.Fields.hpTemp"}}<input class="fnri-number" type="text" data-dtype="Number" data-integer="true" inputmode="decimal" name="system.hp.temp" value="{{system.hp.temp}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.hp.temp}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.hp.temp}}</small>{{/if}}</label></div>
  <div class="fnri-grid-3 fnri-stats-section"><label>{{localize "FASTNRI.Fields.speed"}}<input class="fnri-number" type="text" data-dtype="Number" inputmode="decimal" name="system.speed" value="{{system.speed}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.speed}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.speed}}</small>{{/if}}</label>
<label>{{localize "FASTNRI.Fields.combatDie"}}<input type="text" name="system.combatDie" value="{{system.combatDie}}" {{#unless editable}}disabled{{/unless}}></label>
<label>{{localize "FASTNRI.Fields.attackModifier"}}<input class="fnri-number" type="text" data-dtype="Number" inputmode="decimal" name="system.attackModifier" value="{{system.attackModifier}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.attackModifier}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.attackModifier}}</small>{{/if}}</label></div>
</details>
<details class="fnri-panel fnri-collapsible" data-fnri-section="ac" {{#if sections.ac}}open{{/if}}><summary>{{localize "FASTNRI.Sections.ac"}}</summary>
  
  <div class="fnri-grid-3"><label>{{localize "FASTNRI.Fields.partial"}}<input class="fnri-number" type="text" data-dtype="Number" inputmode="decimal" name="system.ac.partial" value="{{system.ac.partial}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.ac.partial}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.ac.partial}}</small>{{/if}}</label>
<label>{{localize "FASTNRI.Fields.success"}}<input class="fnri-number" type="text" data-dtype="Number" inputmode="decimal" name="system.ac.success" value="{{system.ac.success}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.ac.success}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.ac.success}}</small>{{/if}}</label>
<label>{{localize "FASTNRI.Fields.great"}}<input class="fnri-number" type="text" data-dtype="Number" inputmode="decimal" name="system.ac.great" value="{{system.ac.great}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.ac.great}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.ac.great}}</small>{{/if}}</label></div>
</details>
<details class="fnri-panel fnri-collapsible" data-fnri-section="defenses" {{#if sections.defenses}}open{{/if}}><summary>{{localize "FASTNRI.Sections.defenses"}}</summary>
  
  <div class="fnri-grid-4"><label>{{localize "FASTNRI.Fields.awareness"}}<input class="fnri-number" type="text" data-dtype="Number" inputmode="decimal" name="system.defenses.awareness" value="{{system.defenses.awareness}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.defenses.awareness}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.defenses.awareness}}</small>{{/if}}</label>
<label>{{localize "FASTNRI.Fields.reflex"}}<input class="fnri-number" type="text" data-dtype="Number" inputmode="decimal" name="system.defenses.reflex" value="{{system.defenses.reflex}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.defenses.reflex}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.defenses.reflex}}</small>{{/if}}</label>
<label>{{localize "FASTNRI.Fields.fortitude"}}<input class="fnri-number" type="text" data-dtype="Number" inputmode="decimal" name="system.defenses.fortitude" value="{{system.defenses.fortitude}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.defenses.fortitude}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.defenses.fortitude}}</small>{{/if}}</label>
<label>{{localize "FASTNRI.Fields.will"}}<input class="fnri-number" type="text" data-dtype="Number" inputmode="decimal" name="system.defenses.will" value="{{system.defenses.will}}" {{#unless editable}}disabled{{/unless}}>{{#if effectiveDiffs.defenses.will}}<small class="fnri-effective">{{localize "FASTNRI.Fields.effective"}}: {{effectiveSystem.defenses.will}}</small>{{/if}}</label></div>
</details><details class="fnri-panel fnri-collapsible" data-fnri-section="effects" {{#if sections.effects}}open{{/if}}><summary>{{localize "FASTNRI.Sections.effects"}}</summary>
 
 {{#if editable}}
 <div class="fnri-effect-create">
 <label>{{localize "FASTNRI.Fields.effectTarget"}}<select data-fnri-effect-key>{{#each effectTargets}}<option value="{{this.key}}">{{this.name}}</option>{{/each}}</select></label>
 <label>{{localize "FASTNRI.Fields.effectAmount"}}<input type="text" class="fnri-number" value="2" data-fnri-effect-amount inputmode="decimal"></label>
 <button type="button" data-action="createEffect">{{localize "FASTNRI.Actions.createEffect"}}</button>
 </div>{{/if}}
 <ul class="fnri-item-list">{{#each effectRows}}
 <li class="fnri-item-row"><span>{{this.name}} {{#if this.disabled}}<small>({{localize "FASTNRI.Hints.effectDisabled"}})</small>{{/if}}</span>
 <button type="button" data-action="editEffect" data-id="{{this.id}}" title="{{localize 'FASTNRI.Actions.editEffect'}}"><i class="fa-solid fa-pen"></i></button>
 {{#if @root.editable}}<button type="button" data-action="toggleEffect" data-id="{{this.id}}" title="{{localize 'FASTNRI.Actions.toggleEffect'}}"><i class="fa-solid fa-power-off"></i></button>
 <button type="button" data-action="deleteEffect" data-id="{{this.id}}" title="{{localize 'FASTNRI.Actions.deleteEffect'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</li>
 {{else}}<li class="fnri-muted">{{localize "FASTNRI.Hints.noEffects"}}</li>{{/each}}</ul>
 </details><details class="fnri-panel fnri-collapsible" data-fnri-section="resources" {{#if sections.resources}}open{{/if}}><summary>{{localize "FASTNRI.Sections.resources"}}</summary><div class="fnri-row-head">
    {{#if editable}}<button type="button" data-action="addResource">{{localize "FASTNRI.Actions.addResource"}}</button>{{/if}}</div>
    <div class="fnri-entry fnri-resource-row" data-fnri-resource="potions">
      <span>{{localize "FASTNRI.Potions.name"}}</span>
      {{#if editable}}<button type="button" data-action="adjustResource" data-resource="potions" data-delta="-1" title="{{localize 'FASTNRI.Actions.decreaseResource'}}" aria-label="{{localize 'FASTNRI.Actions.decreaseResource'}}">−</button>{{else}}<span></span>{{/if}}
      <input type="text" class="fnri-number" inputmode="numeric" name="system.potionsUsed" data-dtype="Number" data-integer="true" value="{{potions.used}}" aria-label="{{localize 'FASTNRI.Potions.name'}}" {{#unless editable}}disabled{{/unless}}>
      <span class="fnri-resource-slash">/</span><span class="fnri-resource-max">{{potions.max}}</span>
      {{#if editable}}<button type="button" data-action="adjustResource" data-resource="potions" data-delta="1" title="{{localize 'FASTNRI.Actions.increaseResource'}}" aria-label="{{localize 'FASTNRI.Actions.increaseResource'}}">+</button>{{else}}<span></span>{{/if}}
      <span></span>
      {{#if potions.over}}<small class="fnri-racial-warning fnri-resource-warning">{{localize "FASTNRI.Potions.over"}}</small>{{/if}}
    </div>
    <div class="fnri-stack">{{#each resourceRows}}
      <div class="fnri-entry fnri-resource-row" data-fnri-resource="{{this.id}}">
        <input type="text" data-row-collection="resources" data-row-id="{{this.id}}" data-row-field="name" value="{{this.name}}" aria-label="{{localize 'FASTNRI.Fields.name'}}" {{#unless @root.editable}}disabled{{/unless}}>
        {{#if @root.editable}}<button type="button" data-action="adjustResource" data-resource="row" data-id="{{this.id}}" data-delta="-1" title="{{localize 'FASTNRI.Actions.decreaseResource'}}" aria-label="{{localize 'FASTNRI.Actions.decreaseResource'}}">−</button>{{else}}<span></span>{{/if}}
        <input type="text" class="fnri-number" inputmode="decimal" data-row-collection="resources" data-row-id="{{this.id}}" data-row-field="current" value="{{this.current}}" aria-label="{{localize 'FASTNRI.Fields.current'}}" {{#unless @root.editable}}disabled{{/unless}}>
        <span class="fnri-resource-slash">/</span>
        <input type="text" class="fnri-number" inputmode="decimal" data-row-collection="resources" data-row-id="{{this.id}}" data-row-field="max" value="{{this.max}}" aria-label="{{localize 'FASTNRI.Fields.max'}}" {{#unless @root.editable}}disabled{{/unless}}>
        {{#if @root.editable}}<button type="button" data-action="adjustResource" data-resource="row" data-id="{{this.id}}" data-delta="1" title="{{localize 'FASTNRI.Actions.increaseResource'}}" aria-label="{{localize 'FASTNRI.Actions.increaseResource'}}">+</button><button type="button" data-action="removeResource" data-id="{{this.id}}" title="{{localize 'FASTNRI.Actions.removeResource'}}"><i class="fa-solid fa-trash"></i></button>{{else}}<span></span><span></span>{{/if}}
      </div>
    {{else}}<p class="fnri-muted">{{localize "FASTNRI.Hints.noResources"}}</p>{{/each}}</div></details><details class="fnri-panel fnri-collapsible" data-fnri-section="wealth" {{#if sections.wealth}}open{{/if}}><summary>{{localize "FASTNRI.Sections.wealth"}}</summary><div class="fnri-grid-2"><label>{{localize "FASTNRI.Fields.wealth"}}<input type="text" name="system.wealth" value="{{system.wealth}}" {{#unless editable}}disabled{{/unless}}></label></div></details>
{{> fnri-actor-short-rest}}
</div>
{{> fnri-actor-actions}}
<div class="fnri-tab-content" data-fnri-panel="skills" {{#unless tabs.skills}}hidden{{/unless}}><section class="fnri-panel "><h3>{{localize "FASTNRI.Sections.skills"}}</h3><div class="fnri-row-head"><label class="fnri-skill-filter fnri-skill-read-only">{{localize "FASTNRI.Fields.skillFilter"}}<select data-fnri-skill-filter><option value="all" {{#unless skillFilterAssigned}}selected{{/unless}}>{{localize "FASTNRI.Fields.skillAll"}}</option><option value="assigned" {{#if skillFilterAssigned}}selected{{/if}}>{{localize "FASTNRI.Fields.skillAssigned"}}</option></select></label></div>
<div class="fnri-core-skills">
 {{#each catalogGroups}}
 <div class="fnri-skill-group">
 <button type="button" class="fnri-skill-group-toggle" data-action="toggleSkillGroup" data-group="{{this.id}}" aria-expanded="{{#if this.expanded}}true{{else}}false{{/if}}">{{this.name}}</button>
 <div data-fnri-skill-group-content="{{this.id}}" {{#unless this.expanded}}hidden{{/unless}}>
 <div class="fnri-skill-column-head fnri-core-head" aria-hidden="true"><span>{{localize "FASTNRI.Fields.skill"}}</span><span>{{localize "FASTNRI.Fields.dice"}}</span><span>{{localize "FASTNRI.Fields.checkModifier"}}</span><span></span></div>
 <div class="fnri-stack">
 {{#each this.rows}}
 {{> fnri-actor-core-skill}}
 {{/each}}
 <div class="fnri-group-specializations-list">{{#if this.specializations}}<small>{{localize "FASTNRI.Fields.specialization"}}</small>{{/if}}
 {{#each this.specializations}}{{> fnri-actor-custom-skill}}{{/each}}{{#if @root.editable}}<button type="button" data-action="addSpecialization" data-group="{{this.id}}">{{localize "FASTNRI.Actions.addSpecialization"}}</button>{{/if}}</div>
 </div>
 </div></div>
 {{/each}}
 </div>
 <div class="fnri-skill-group fnri-custom-group">
 <button type="button" class="fnri-skill-group-toggle" data-action="toggleSkillGroup" data-group="custom" aria-expanded="{{#if customGroupExpanded}}true{{else}}false{{/if}}">{{localize "FASTNRI.Sections.customChecks"}}</button>
 <div data-fnri-skill-group-content="custom" {{#unless customGroupExpanded}}hidden{{/unless}}>
 <div class="fnri-skill-column-head fnri-custom-head" aria-hidden="true"><span>{{localize "FASTNRI.Fields.name"}}</span><span>{{localize "FASTNRI.Fields.dice"}}</span><span>{{localize "FASTNRI.Fields.checkModifier"}}</span><span></span></div>
 <div class="fnri-stack">{{#each skillRows}}
{{> fnri-actor-custom-skill}}
{{/each}}{{#if editable}}<button type="button" data-action="addSkill">{{localize "FASTNRI.Actions.addSkill"}}</button>{{/if}}</div></div></div></section></div>
<div class="fnri-tab-content" data-fnri-panel="abilities" {{#unless tabs.abilities}}hidden{{/unless}}><section class="fnri-panel "><h3>{{localize "FASTNRI.Sections.abilities"}}</h3><div class="fnri-row-head"><p class="fnri-muted">{{localize "FASTNRI.Hints.dropItems"}}</p>
{{#if editable}}<button type="button" data-action="createItem" data-type="ability">{{localize "FASTNRI.Actions.createAbility"}}</button>{{/if}}</div><ul class="fnri-item-list">
{{#if invocation}}
<li class="fnri-item-row">
  <span>{{invocation.name}}</span>
  {{#if editable}}<button type="button" data-action="invokeFromSheet" data-id="invocation" title="{{invocation.name}}" aria-label="{{invocation.name}}"><i class="fa-solid fa-play" aria-hidden="true"></i></button>{{/if}}
</li>
{{/if}}
{{#each abilityItems}}
  <li data-item-id="{{this.id}}" class="fnri-item-row">
    <img src="{{this.img}}" alt="">
    <span>{{this.name}}</span>
    <small>{{this.type}}</small>
    <button type="button" data-action="publishAbility" title="{{localize 'FASTNRI.AbilityChat.toChat'}}" aria-label="{{localize 'FASTNRI.AbilityChat.toChat'}}"><i class="fa-solid fa-comment"></i></button>
    {{#if this.hasRollFormula}}<button type="button" data-action="rollAbility" title="{{localize 'FASTNRI.Actions.rollAbility'}}"><i class="fa-solid fa-dice-d20"></i></button>{{/if}}
    {{#if @root.editable}}
    {{#if this.doubleInvocation}}<button type="button" data-action="invokeFromSheet" data-id="doubleInvocation" title="{{this.name}}" aria-label="{{this.name}}"><i class="fa-solid fa-play" aria-hidden="true"></i></button>{{/if}}
    {{#if this.grantedAction}}<button type="button" data-action="openGrantedAction" data-id="{{this.grantedAction}}" title="{{localize 'FASTNRI.Tabs.actions'}}" aria-label="{{localize 'FASTNRI.Tabs.actions'}}"><i class="fa-solid fa-share-from-square" aria-hidden="true"></i></button>{{/if}}
    {{/if}}
    <button type="button" data-action="openItem" title="{{localize 'FASTNRI.Actions.openItem'}}"><i class="fa-solid fa-arrow-up-right-from-square"></i></button>
    {{#if @root.editable}}<button type="button" data-action="deleteItem" title="{{localize 'FASTNRI.Actions.deleteItem'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
  </li>
{{/each}}
</ul></section></div>
<div class="fnri-tab-content" data-fnri-panel="inventory" {{#unless tabs.inventory}}hidden{{/unless}}>
<section class="fnri-panel"><h3>{{localize "FASTNRI.Sections.inventory"}}</h3>
 <div class="fnri-equipped-hands">
   {{#each attackHands}}<span><strong>{{this.label}}</strong> {{#if this.name}}{{this.name}}{{else}}—{{/if}}</span>{{/each}}
 </div>
 <button type="button" data-action="declareSheetAction" data-id="transferItem">{{localize "FASTNRI.SheetActions.cards.transferItem.name"}}</button>

 <div class="fnri-row-head"><span class="fnri-muted">{{localize "FASTNRI.Hints.dropItems"}}</span>
  {{#if editable}}<div class="fnri-actions">
    <button type="button" data-action="createItem" data-type="weapon">{{localize "TYPES.Item.weapon"}}</button>
    <button type="button" data-action="createItem" data-type="armor">{{localize "TYPES.Item.armor"}}</button>
    <button type="button" data-action="createItem" data-type="gear">{{localize "TYPES.Item.gear"}}</button>
  </div>{{/if}}
 </div><ul class="fnri-item-list">
  {{#each inventoryItems}}
  <li data-item-id="{{this.id}}" class="fnri-item-row {{#if this.isEquipped}}fnri-item-equipped{{/if}}">
    <img src="{{this.img}}" alt="">
    <span class="fnri-inventory-name">{{this.name}}{{#if this.isEquipped}}<small class="fnri-equipped-location">{{this.equipmentLabel}}</small>{{/if}}</span>
    <small>{{this.type}}</small>
    {{#if @root.editable}}{{#if this.canEquip}}<button type="button" class="fnri-equip-toggle" data-action="toggleEquipment" title="{{#if this.isEquipped}}{{localize 'FASTNRI.Actions.unequip'}}{{else}}{{localize 'FASTNRI.Actions.equip'}}{{/if}}">{{#if this.isEquipped}}{{localize "FASTNRI.Actions.unequip"}}{{else}}{{localize "FASTNRI.Actions.equip"}}{{/if}}</button>{{/if}}{{/if}}
    {{#if @root.editable}}{{#if this.canUse}}<button type="button" class="fnri-use-item" data-action="useInventoryItem" title="{{localize 'FASTNRI.SheetActions.useItem'}}">{{localize "FASTNRI.SheetActions.useItem"}}</button>{{/if}}{{/if}}
    {{#if @root.editable}}{{#if this.canReload}}<button type="button" class="fnri-use-item" data-action="declareSheetAction" data-id="reload">{{localize "FASTNRI.SheetActions.reloadItem"}}</button>{{/if}}{{/if}}
    <button type="button" data-action="openItem" title="{{localize 'FASTNRI.Actions.openItem'}}"><i class="fa-solid fa-arrow-up-right-from-square"></i></button>
    {{#if @root.editable}}<button type="button" data-action="deleteItem" title="{{localize 'FASTNRI.Actions.deleteItem'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
  </li>
  {{else}}<li class="fnri-empty">{{localize "FASTNRI.Hints.noItems"}}</li>{{/each}}
 </ul>
{{#if hasMissingEquipment}}<div class="fnri-row-head fnri-warning"><span>{{localize "FASTNRI.Hints.clearMissingEquipment"}}</span>
  {{#if editable}}<button type="button" data-action="cleanOrphanedEquipment">{{localize "FASTNRI.Equipment.cleanMissing"}}</button>{{/if}}</div>{{/if}}
</section></div>
<div class="fnri-tab-content" data-fnri-panel="description" {{#unless tabs.description}}hidden{{/unless}}><section class="fnri-panel "><h3>{{localize "FASTNRI.Sections.description"}}</h3><textarea name="system.description" rows="7" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea></section><section class="fnri-panel "><h3>{{localize "FASTNRI.Sections.notes"}}</h3><textarea name="system.notes" rows="6" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></section></div>
{{#if projectionFullAvailable}}<button type="button" data-action="toggleProjectionFull" class="fnri-projection-full">{{localize "FASTNRI.Projection.shortSheet"}}</button>{{/if}}
</section>


{{/if}}
