      <div class="fnri-entry fnri-resource-row" data-fnri-resource="{{this.id}}">
        <input type="text" data-row-collection="resources" data-row-id="{{this.id}}" data-row-field="name" value="{{this.name}}" aria-label="{{localize 'FASTNRI.Fields.name'}}" {{#unless @root.editable}}disabled{{/unless}}>
        {{#if @root.editable}}<button type="button" data-action="adjustResource" data-resource="row" data-id="{{this.id}}" data-delta="-1" title="{{localize 'FASTNRI.Actions.decreaseResource'}}" aria-label="{{localize 'FASTNRI.Actions.decreaseResource'}}">−</button>{{else}}<span></span>{{/if}}
        <input type="text" class="fnri-number" inputmode="decimal" data-row-collection="resources" data-row-id="{{this.id}}" data-row-field="current" value="{{this.current}}" aria-label="{{localize 'FASTNRI.Fields.current'}}" {{#unless @root.editable}}disabled{{/unless}}>
        <span class="fnri-resource-slash">/</span>
        <input type="text" class="fnri-number fnri-resource-edit-only" inputmode="decimal" data-row-collection="resources" data-row-id="{{this.id}}" data-row-field="max" value="{{this.max}}" aria-label="{{localize 'FASTNRI.Fields.max'}}" {{#unless @root.editable}}disabled{{/unless}}>
        <span class="fnri-resource-read-only fnri-resource-max">{{this.effectiveMax}}</span>
        {{#if @root.editable}}<button type="button" data-action="adjustResource" data-resource="row" data-id="{{this.id}}" data-delta="1" title="{{localize 'FASTNRI.Actions.increaseResource'}}" aria-label="{{localize 'FASTNRI.Actions.increaseResource'}}">+</button><button type="button" data-action="removeResource" data-fnri-lock-section data-id="{{this.id}}" title="{{localize 'FASTNRI.Actions.removeResource'}}"><i class="fa-solid fa-trash"></i></button>{{else}}<span></span><span></span>{{/if}}
        {{#if this.currentDiff}}<small class="fnri-resource-warning">{{localize "FASTNRI.ResourceAssignment.effective"}}: {{this.effectiveCurrent}}</small>{{/if}}
        <label class="fnri-resource-warning" data-fnri-lock-section>{{localize "FASTNRI.ResourceAssignment.label"}} <select data-row-collection="resources" data-row-id="{{this.id}}" data-row-field="assignment" {{#unless @root.editable}}disabled{{/unless}}>{{#each this.assignments}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      </div>
