<section class="fnri-body fnri-item-body">
  <header class="fnri-heading">
    <img src="{{item.img}}" alt="" class="fnri-portrait" />
    <div class="fnri-heading-fields">
      <label>{{localize "FASTNRI.Fields.name"}}<input type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}} /></label>
      <div class="fnri-type">{{localize "FASTNRI.Fields.type"}}: {{item.type}}</div>
      {{#if deprecated}}<p class="fnri-deprecated">{{localize "FASTNRI.Hints.deprecated"}}</p>{{/if}}
    </div>
  </header>
  <section class="fnri-panel">
    <h3>{{localize "FASTNRI.Sections.roll"}}</h3>
    <label>{{localize "FASTNRI.Fields.rollFormula"}}<input type="text" name="system.rollFormula" value="{{system.rollFormula}}" placeholder="1d20 + 2d6" {{#unless editable}}disabled{{/unless}}></label>
    <label>{{localize "FASTNRI.Damage.interventionProperty"}}<select data-dtype="Boolean" name="system.mechanics.isIntervention" {{#unless editable}}disabled{{/unless}}>
      <option value="false" {{#unless itemIsIntervention}}selected{{/unless}}>{{localize "FASTNRI.Damage.no"}}</option>
      <option value="true" {{#if itemIsIntervention}}selected{{/if}}>{{localize "FASTNRI.Damage.yes"}}</option>
    </select></label>
    {{#if hasRollFormula}}<button type="button" data-action="itemRoll"><i class="fa-solid fa-dice-d20"></i> {{localize "FASTNRI.Actions.rollItem"}}</button>{{/if}}
    
  </section>
  <section class="fnri-panel">
    <div class="fnri-row-head"><h3>{{localize "FASTNRI.Sections.itemEffects"}}</h3>
      {{#if editable}}<button type="button" data-action="createItemEffect">{{localize "FASTNRI.Actions.createEffect"}}</button>{{/if}}
    </div>
    <ul class="fnri-item-list">{{#each itemEffects}}
      <li class="fnri-item-row"><span>{{this.name}} {{#if this.transfer}}<small>({{localize "FASTNRI.Hints.transferEffect"}})</small>{{/if}}
        {{#if this.disabled}}<small>({{localize "FASTNRI.Hints.effectDisabled"}})</small>{{/if}}</span>
        <button type="button" data-action="editItemEffect" data-id="{{this.id}}"><i class="fa-solid fa-pen"></i></button>
        {{#if @root.editable}}<button type="button" data-action="toggleItemEffect" data-id="{{this.id}}"><i class="fa-solid fa-power-off"></i></button>
          <button type="button" data-action="deleteItemEffect" data-id="{{this.id}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
      </li>{{else}}<li class="fnri-muted">{{localize "FASTNRI.Hints.noEffects"}}</li>{{/each}}
    </ul>
  </section>
  <section class="fnri-panel">
    <h3>{{localize "FASTNRI.Sections.properties"}}</h3>
    {{#if isWeapon}}
      <div class="fnri-weapon-fields fnri-grid-3">
        <label>{{localize "FASTNRI.Weapon.level"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.level" value="{{system.level}}" {{#unless editable}}disabled{{/unless}}></label>
        <label>{{localize "FASTNRI.Fields.category"}}<input type="text" name="system.category" value="{{system.category}}" {{#unless editable}}disabled{{/unless}}></label>
        <label>{{localize "FASTNRI.Weapon.grip"}}<input type="text" name="system.grip" value="{{system.grip}}" placeholder="1 / 1+ / 2" {{#unless editable}}disabled{{/unless}}></label>
        <label>{{localize "FASTNRI.Weapon.distance"}}<input type="text" name="system.distance" value="{{system.distance}}" {{#unless editable}}disabled{{/unless}}></label>
        <label>{{localize "FASTNRI.Weapon.attackKind"}}<select name="system.attackKind" {{#unless editable}}disabled{{/unless}}>
          <option value="" {{#if weaponUnknownKind}}selected{{/if}}>{{localize "FASTNRI.Weapon.kindUnknown"}}</option>
          {{#if weaponLegacyKind}}<option value="{{weaponLegacyKind}}" selected>{{weaponLegacyKind}} ({{localize "FASTNRI.Weapon.legacyKind"}})</option>{{/if}}
          <option value="melee" {{#if weaponMelee}}selected{{/if}}>{{localize "FASTNRI.Weapon.melee"}}</option>
          <option value="ranged" {{#if weaponRanged}}selected{{/if}}>{{localize "FASTNRI.Weapon.ranged"}}</option>
          <option value="focus" {{#if weaponFocus}}selected{{/if}}>{{localize "FASTNRI.Weapon.focus"}}</option>
        </select></label>
        <label>{{localize "FASTNRI.Weapon.damageType"}}<input type="text" name="system.damageType" value="{{system.damageType}}" {{#unless editable}}disabled{{/unless}}></label>
      </div>
      <label>{{localize "FASTNRI.Weapon.owners"}}<input type="text" name="system.proficiencyClasses" value="{{system.proficiencyClasses}}" {{#unless editable}}disabled{{/unless}}></label>
      <label>{{localize "FASTNRI.Weapon.proficiencyMode"}}<select name="system.proficiencyMode" {{#unless editable}}disabled{{/unless}}>
        <option value="auto" {{#if weaponAutoProficiency}}selected{{/if}}>{{localize "FASTNRI.Weapon.autoProficiency"}}</option>
        <option value="yes" {{#if weaponYesProficiency}}selected{{/if}}>{{localize "FASTNRI.Weapon.yesProficiency"}}</option>
        <option value="no" {{#if weaponNoProficiency}}selected{{/if}}>{{localize "FASTNRI.Weapon.noProficiency"}}</option>
      </select></label>
      <label>{{localize "FASTNRI.Weapon.properties"}}<input type="text" name="system.properties" value="{{system.properties}}" {{#unless editable}}disabled{{/unless}}></label>
      {{#if computedReach}}<p class="fnri-muted fnri-computed-reach">{{localize "FASTNRI.Weapon.computedReach"}}</p>{{/if}}
      <details class="fnri-weapon-legacy"><summary>{{localize "FASTNRI.Weapon.legacyFields"}}</summary>
        <div class="fnri-grid-3">
          <label>{{localize "FASTNRI.Fields.hands"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.hands" value="{{system.hands}}" {{#unless editable}}disabled{{/unless}}></label>
          <label>{{localize "FASTNRI.Fields.reach"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.reach" value="{{system.reach}}" {{#unless editable}}disabled{{/unless}}></label>
          <label>{{localize "FASTNRI.Fields.range"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.range" value="{{system.range}}" {{#unless editable}}disabled{{/unless}}></label>
        </div>
      </details>
      <h3>{{localize "FASTNRI.Weapon.damageProfile"}}</h3>
      <div class="fnri-grid-3 fnri-weapon-damage-fields">
        <label>{{localize "FASTNRI.Fields.partial"}} (A)<input type="text" name="system.damageProfile.A" value="{{system.damageProfile.A}}" placeholder="1d6" {{#unless editable}}disabled{{/unless}}></label>
        <label>{{localize "FASTNRI.Fields.success"}} (B)<input type="text" name="system.damageProfile.B" value="{{system.damageProfile.B}}" placeholder="1d8" {{#unless editable}}disabled{{/unless}}></label>
        <label>{{localize "FASTNRI.Fields.great"}} (+C)<input type="text" data-dtype="Number" inputmode="decimal" name="system.damageProfile.C" value="{{system.damageProfile.C}}" placeholder="3" {{#unless editable}}disabled{{/unless}}></label>
      </div>
      <div class="fnri-grid-3 fnri-critical-rules">
        <label>{{localize "FASTNRI.Damage.criticalThreshold"}}<input type="number" min="1" max="20" step="1" data-dtype="Number" name="system.mechanics.attack.criticalThreshold" value="{{system.mechanics.attack.criticalThreshold}}" placeholder="20" {{#unless editable}}disabled{{/unless}}></label>
        <label>{{localize "FASTNRI.Damage.criticalMultiplier"}}<input type="number" min="2" step="1" data-dtype="Number" name="system.mechanics.attack.criticalMultiplier" value="{{system.mechanics.attack.criticalMultiplier}}" placeholder="2" {{#unless editable}}disabled{{/unless}}></label>
      </div>
      <details class="fnri-defense-settings"><summary>{{localize "FASTNRI.Damage.defenseSettings"}}</summary>
        <label>{{localize "FASTNRI.Damage.attackTargetDefense"}}<select name="system.mechanics.attack.targetDefense" {{#unless editable}}disabled{{/unless}}>
          {{#each targetDefenseOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select></label>
        <label>{{localize "FASTNRI.Damage.selfDefenseMode"}}<select name="system.mechanics.attack.selfDefense.mode" {{#unless editable}}disabled{{/unless}}>
          {{#each attackDefenseModes}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select></label>
        <label>{{localize "FASTNRI.Damage.selfDefenseStat"}}<select name="system.mechanics.attack.selfDefense.stat" {{#unless editable}}disabled{{/unless}}>
          {{#each attackDefenseStats}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select></label>
        <label>{{localize "FASTNRI.Damage.selfDefenseOptions"}}<input name="system.mechanics.attack.selfDefense.options" value="{{attackDefenseChoices}}" placeholder="fortitude, reflex, will" {{#unless editable}}disabled{{/unless}}></label>
      </details>
      {{#if canWeaponAttack}}<button type="button" data-action="weaponAttack"><i class="fa-solid fa-crosshairs"></i> {{localize "FASTNRI.Weapon.attack"}}</button>{{/if}}
      {{#if weaponRuleRows.length}}<div class="fnri-weapon-property-reference"><h3>{{localize "FASTNRI.Weapon.propertyRules"}}</h3>
        {{#each weaponRuleRows}}<details><summary>{{this.name}}</summary><p>{{this.description}}</p></details>{{/each}}
      </div>{{/if}}
      <p class="fnri-muted">{{localize "FASTNRI.Weapon.manualPropertyHint"}}</p>
    {{/if}}
    {{#if isArmor}}
      <div class="fnri-grid-3">
        <label>{{localize "FASTNRI.Fields.partial"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.ac.partial" value="{{system.ac.partial}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.success"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.ac.success" value="{{system.ac.success}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.great"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.ac.great" value="{{system.ac.great}}" {{#unless editable}}disabled{{/unless}} /></label>
      </div>
    {{/if}}
    {{#if isGear}}
      <div class="fnri-grid-3">
        <label>{{localize "FASTNRI.Fields.category"}}<input type="text" name="system.category" value="{{system.category}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.quantity"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.quantity" value="{{system.quantity}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.charges"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.charges" value="{{system.charges}}" {{#unless editable}}disabled{{/unless}} /></label>
      </div>
    {{/if}}
    {{#if isGear}}
      <details class="fnri-optional-attack"><summary>{{localize "FASTNRI.Equipment.cardOptions"}}</summary>
        <label>{{localize "FASTNRI.Equipment.slotRule"}}<select name="system.mechanics.equipment.slot" {{#unless editable}}disabled{{/unless}}>
          <option value="">{{localize "FASTNRI.Equipment.slotAuto"}}</option>
          <option value="hand" {{#if gearHand}}selected{{/if}}>{{localize "FASTNRI.Equipment.slotHand"}}</option>
          <option value="armor" {{#if gearArmor}}selected{{/if}}>{{localize "FASTNRI.Fields.armorSlot"}}</option>
          <option value="other" {{#if gearOther}}selected{{/if}}>{{localize "FASTNRI.Equipment.other"}}</option>
        </select></label>
        <label>{{localize "FASTNRI.Equipment.otherAttack"}}<select name="system.mechanics.attack.kind" {{#unless editable}}disabled{{/unless}}>
          <option value="">—</option><option value="physical" {{#if gearPhysicalAttack}}selected{{/if}}>{{localize "FASTNRI.Equipment.physicalAttack"}}</option>
        </select></label>
        <label>{{localize "FASTNRI.Fields.rollFormula"}}<input name="system.mechanics.attack.rollFormula" value="{{system.mechanics.attack.rollFormula}}" placeholder="1d20" {{#unless editable}}disabled{{/unless}}></label>
        <div class="fnri-grid-3">
          <label>A<input name="system.mechanics.attack.damageProfile.A" value="{{system.mechanics.attack.damageProfile.A}}" placeholder="1d4" {{#unless editable}}disabled{{/unless}}></label>
          <label>B<input name="system.mechanics.attack.damageProfile.B" value="{{system.mechanics.attack.damageProfile.B}}" placeholder="1d4" {{#unless editable}}disabled{{/unless}}></label>
          <label>+C<input type="text" data-dtype="Number" name="system.mechanics.attack.damageProfile.C" value="{{system.mechanics.attack.damageProfile.C}}" placeholder="1" {{#unless editable}}disabled{{/unless}}></label>
        </div>
        <label>{{localize "FASTNRI.Weapon.damageType"}}<input name="system.mechanics.attack.damageType" value="{{system.mechanics.attack.damageType}}" {{#unless editable}}disabled{{/unless}}></label>
      </details>
    {{/if}}
    {{#if isAbility}}
      <div class="fnri-grid-2">
        <label>{{localize "FASTNRI.Fields.category"}}<input type="text" name="system.category" value="{{system.category}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.cost"}}<input type="text" name="system.cost" value="{{system.cost}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.trigger"}}<input type="text" name="system.trigger" value="{{system.trigger}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.frequency"}}<input type="text" name="system.frequency" value="{{system.frequency}}" {{#unless editable}}disabled{{/unless}} /></label>
      </div>
      <label>{{localize "FASTNRI.Fields.effect"}}<textarea name="system.effect" rows="3" {{#unless editable}}disabled{{/unless}}>{{system.effect}}</textarea></label>
      <details class="fnri-optional-attack"><summary>{{localize "FASTNRI.Equipment.unarmedCardRule"}}</summary>
        <label>{{localize "FASTNRI.Equipment.unarmedReplace"}}<select name="system.mechanics.unarmedAttack.mode" {{#unless editable}}disabled{{/unless}}>
          <option value="">—</option><option value="replace" {{#if abilityReplaceUnarmed}}selected{{/if}}>{{localize "FASTNRI.Equipment.replace"}}</option><option value="option" {{#if abilityOptionUnarmed}}selected{{/if}}>{{localize "FASTNRI.Equipment.unarmedOption"}}</option>
        </select></label>
        <label>{{localize "FASTNRI.Fields.name"}}<input name="system.mechanics.unarmedAttack.name" value="{{system.mechanics.unarmedAttack.name}}" {{#unless editable}}disabled{{/unless}}></label>
        <label>{{localize "FASTNRI.Fields.rollFormula"}}<input name="system.mechanics.unarmedAttack.rollFormula" value="{{system.mechanics.unarmedAttack.rollFormula}}" placeholder="1d20 + 1d8" {{#unless editable}}disabled{{/unless}}></label>
        <div class="fnri-grid-3">
          <label>A<input name="system.mechanics.unarmedAttack.damageProfile.A" value="{{system.mechanics.unarmedAttack.damageProfile.A}}" placeholder="1d6" {{#unless editable}}disabled{{/unless}}></label>
          <label>B<input name="system.mechanics.unarmedAttack.damageProfile.B" value="{{system.mechanics.unarmedAttack.damageProfile.B}}" placeholder="1d8" {{#unless editable}}disabled{{/unless}}></label>
          <label>+C<input type="text" data-dtype="Number" name="system.mechanics.unarmedAttack.damageProfile.C" value="{{system.mechanics.unarmedAttack.damageProfile.C}}" placeholder="2" {{#unless editable}}disabled{{/unless}}></label>
        </div>
        <label>{{localize "FASTNRI.Weapon.damageType"}}<input name="system.mechanics.unarmedAttack.damageType" value="{{system.mechanics.unarmedAttack.damageType}}" {{#unless editable}}disabled{{/unless}}></label>
        <div class="fnri-grid-3 fnri-critical-rules">
          <label>{{localize "FASTNRI.Damage.criticalThreshold"}}<input type="number" min="1" max="20" step="1" data-dtype="Number" name="system.mechanics.unarmedAttack.criticalThreshold" value="{{system.mechanics.unarmedAttack.criticalThreshold}}" placeholder="20" {{#unless editable}}disabled{{/unless}}></label>
          <label>{{localize "FASTNRI.Damage.criticalMultiplier"}}<input type="number" min="2" step="1" data-dtype="Number" name="system.mechanics.unarmedAttack.criticalMultiplier" value="{{system.mechanics.unarmedAttack.criticalMultiplier}}" placeholder="2" {{#unless editable}}disabled{{/unless}}></label>
        </div>
      </details>
    {{/if}}
    {{#if gearPhysicalAttack}}
      <details class="fnri-critical-rules"><summary>{{localize "FASTNRI.Damage.criticalSettings"}}</summary>
        <div class="fnri-grid-3">
          <label>{{localize "FASTNRI.Damage.criticalThreshold"}}<input type="number" min="1" max="20" step="1" data-dtype="Number" name="system.mechanics.attack.criticalThreshold" value="{{system.mechanics.attack.criticalThreshold}}" placeholder="20" {{#unless editable}}disabled{{/unless}}></label>
          <label>{{localize "FASTNRI.Damage.criticalMultiplier"}}<input type="number" min="2" step="1" data-dtype="Number" name="system.mechanics.attack.criticalMultiplier" value="{{system.mechanics.attack.criticalMultiplier}}" placeholder="2" {{#unless editable}}disabled{{/unless}}></label>
        </div>
      </details>
    {{/if}}
    {{#if isAbility}}<details class="fnri-defense-settings"><summary>{{localize "FASTNRI.Damage.defenseSettings"}}</summary>
      <label>{{localize "FASTNRI.Damage.selfDefenseActivation"}}<select name="system.mechanics.selfDefense.activation" {{#unless editable}}disabled{{/unless}}>
        {{#each abilityDefenseActivations}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
      </select></label>
      <label>{{localize "FASTNRI.Damage.selfDefenseMode"}}<select name="system.mechanics.selfDefense.mode" {{#unless editable}}disabled{{/unless}}>
        {{#each abilityDefenseModes}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
      </select></label>
      <label>{{localize "FASTNRI.Damage.selfDefenseStat"}}<select name="system.mechanics.selfDefense.stat" {{#unless editable}}disabled{{/unless}}>
        {{#each abilityDefenseStats}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
      </select></label>
      <label>{{localize "FASTNRI.Damage.selfDefenseOptions"}}<input name="system.mechanics.selfDefense.options" value="{{abilityDefenseChoices}}" placeholder="fortitude, reflex, will" {{#unless editable}}disabled{{/unless}}></label>
      <label>{{localize "FASTNRI.Damage.againstKind"}}<select name="system.mechanics.selfDefense.againstKind" {{#unless editable}}disabled{{/unless}}>
        {{#each abilityAgainstKinds}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
      </select></label>
    </details>{{/if}}
    {{#unless isLegacy}}
      <label>{{localize "FASTNRI.Fields.tags"}}<input type="text" name="system.tags" value="{{system.tags}}" {{#unless editable}}disabled{{/unless}} /></label>
    {{/unless}}
    {{#if isLegacy}}
      <label>{{localize "FASTNRI.Fields.tags"}}<input type="text" name="system.tags" value="{{system.tags}}" {{#unless editable}}disabled{{/unless}} /></label>
    {{/if}}
  </section>
  <section class="fnri-panel">
    <h3>{{localize "FASTNRI.Sections.description"}}</h3>
    <textarea name="system.description" rows="5" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>
  </section>
  <section class="fnri-panel">
    <h3>{{localize "FASTNRI.Sections.notes"}}</h3>
    <textarea name="system.notes" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea>
  </section>
</section>
