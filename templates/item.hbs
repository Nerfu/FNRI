<section class="fnri-body fnri-item-body">
  <header class="fnri-heading">
    <img src="{{item.img}}" alt="" class="fnri-portrait" />
    <div class="fnri-heading-fields">
      <label>{{localize "FASTNRI.Fields.name"}}<input type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}} /></label>
      <div class="fnri-type">{{localize "FASTNRI.Fields.type"}}: {{item.type}}</div>
      {{#if deprecated}}<p class="fnri-deprecated">{{localize "FASTNRI.Hints.deprecated"}}</p>{{/if}}
    </div>
  </header>
  <section class="fnri-panel">
    <h3>{{localize "FASTNRI.Sections.roll"}}</h3>
    <label>{{localize "FASTNRI.Fields.rollFormula"}}<input type="text" name="system.rollFormula" value="{{system.rollFormula}}" placeholder="1d20 + 2d6" {{#unless editable}}disabled{{/unless}}></label>
    {{#if hasRollFormula}}<button type="button" data-action="itemRoll"><i class="fa-solid fa-dice-d20"></i> {{localize "FASTNRI.Actions.rollItem"}}</button>{{/if}}
    
  </section>
  <section class="fnri-panel">
    <div class="fnri-row-head"><h3>{{localize "FASTNRI.Sections.itemEffects"}}</h3>
      {{#if editable}}<button type="button" data-action="createItemEffect">{{localize "FASTNRI.Actions.createEffect"}}</button>{{/if}}
    </div>
    <ul class="fnri-item-list">{{#each itemEffects}}
      <li class="fnri-item-row"><span>{{this.name}} {{#if this.transfer}}<small>({{localize "FASTNRI.Hints.transferEffect"}})</small>{{/if}}
        {{#if this.disabled}}<small>({{localize "FASTNRI.Hints.effectDisabled"}})</small>{{/if}}</span>
        <button type="button" data-action="editItemEffect" data-id="{{this.id}}"><i class="fa-solid fa-pen"></i></button>
        {{#if @root.editable}}<button type="button" data-action="toggleItemEffect" data-id="{{this.id}}"><i class="fa-solid fa-power-off"></i></button>
          <button type="button" data-action="deleteItemEffect" data-id="{{this.id}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
      </li>{{else}}<li class="fnri-muted">{{localize "FASTNRI.Hints.noEffects"}}</li>{{/each}}
    </ul>
  </section>
  <section class="fnri-panel">
    <h3>{{localize "FASTNRI.Sections.properties"}}</h3>
    {{#if isWeapon}}
      <div class="fnri-grid-3">
        <label>{{localize "FASTNRI.Fields.hands"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.hands" value="{{system.hands}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.reach"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.reach" value="{{system.reach}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.range"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.range" value="{{system.range}}" {{#unless editable}}disabled{{/unless}} /></label>
      </div>
    {{/if}}
    {{#if isArmor}}
      <div class="fnri-grid-3">
        <label>{{localize "FASTNRI.Fields.partial"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.ac.partial" value="{{system.ac.partial}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.success"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.ac.success" value="{{system.ac.success}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.great"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.ac.great" value="{{system.ac.great}}" {{#unless editable}}disabled{{/unless}} /></label>
      </div>
    {{/if}}
    {{#if isGear}}
      <div class="fnri-grid-3">
        <label>{{localize "FASTNRI.Fields.category"}}<input type="text" name="system.category" value="{{system.category}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.quantity"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.quantity" value="{{system.quantity}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.charges"}}<input type="text" data-dtype="Number" inputmode="decimal" class="fnri-number" name="system.charges" value="{{system.charges}}" {{#unless editable}}disabled{{/unless}} /></label>
      </div>
    {{/if}}
    {{#if isAbility}}
      <div class="fnri-grid-2">
        <label>{{localize "FASTNRI.Fields.category"}}<input type="text" name="system.category" value="{{system.category}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.cost"}}<input type="text" name="system.cost" value="{{system.cost}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.trigger"}}<input type="text" name="system.trigger" value="{{system.trigger}}" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "FASTNRI.Fields.frequency"}}<input type="text" name="system.frequency" value="{{system.frequency}}" {{#unless editable}}disabled{{/unless}} /></label>
      </div>
      <label>{{localize "FASTNRI.Fields.effect"}}<textarea name="system.effect" rows="3" {{#unless editable}}disabled{{/unless}}>{{system.effect}}</textarea></label>
    {{/if}}
    {{#unless isLegacy}}
      <label>{{localize "FASTNRI.Fields.tags"}}<input type="text" name="system.tags" value="{{system.tags}}" {{#unless editable}}disabled{{/unless}} /></label>
    {{/unless}}
    {{#if isLegacy}}
      <label>{{localize "FASTNRI.Fields.tags"}}<input type="text" name="system.tags" value="{{system.tags}}" {{#unless editable}}disabled{{/unless}} /></label>
    {{/if}}
  </section>
  <section class="fnri-panel">
    <h3>{{localize "FASTNRI.Sections.description"}}</h3>
    <textarea name="system.description" rows="5" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>
  </section>
  <section class="fnri-panel">
    <h3>{{localize "FASTNRI.Sections.notes"}}</h3>
    <textarea name="system.notes" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea>
  </section>
</section>
