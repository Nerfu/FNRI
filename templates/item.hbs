<section class="fnri-body fnri-item-body"><header class="fnri-heading"><img src="{{item.img}}" alt="" class="fnri-portrait"/><div class="fnri-heading-fields">
<label>{{localize "FASTNRI.Fields.name"}}<input name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}/></label><div class="fnri-type">{{item.type}}</div>
{{#if deprecated}}<p class="fnri-deprecated">{{localize "FASTNRI.Hints.deprecated"}}</p>{{/if}}{{#if isLegacy}}<p class="fnri-muted">{{localize "FASTNRI.Hints.legacy"}}</p>{{/if}}</div></header>
<section class="fnri-panel"><h3>{{localize "FASTNRI.Sections.properties"}}</h3>
{{#if isWeapon}}<div class="fnri-grid-3"><label>{{localize "FASTNRI.Fields.hands"}}<input type="text" inputmode="decimal" data-dtype="Number" class="fnri-number" step="1" name="system.hands" value="{{system.hands}}" {{#unless editable}}disabled{{/unless}}/></label><label>{{localize "FASTNRI.Fields.reach"}}<input type="text" inputmode="decimal" data-dtype="Number" class="fnri-number" name="system.reach" value="{{system.reach}}" {{#unless editable}}disabled{{/unless}}/></label><label>{{localize "FASTNRI.Fields.range"}}<input type="text" inputmode="decimal" data-dtype="Number" class="fnri-number" name="system.range" value="{{system.range}}" {{#unless editable}}disabled{{/unless}}/></label></div><p class="fnri-muted">{{localize "FASTNRI.Hints.damagePending"}}</p>{{/if}}
{{#if isArmor}}<div class="fnri-grid-3"><label>{{localize "FASTNRI.Fields.partial"}}<input type="text" inputmode="decimal" data-dtype="Number" class="fnri-number" name="system.ac.partial" value="{{system.ac.partial}}" {{#unless editable}}disabled{{/unless}}/></label><label>{{localize "FASTNRI.Fields.success"}}<input type="text" inputmode="decimal" data-dtype="Number" class="fnri-number" name="system.ac.success" value="{{system.ac.success}}" {{#unless editable}}disabled{{/unless}}/></label><label>{{localize "FASTNRI.Fields.great"}}<input type="text" inputmode="decimal" data-dtype="Number" class="fnri-number" name="system.ac.great" value="{{system.ac.great}}" {{#unless editable}}disabled{{/unless}}/></label></div>{{/if}}
{{#if isGear}}<div class="fnri-grid-3"><label>{{localize "FASTNRI.Fields.category"}}<input type="text" name="system.category" value="{{system.category}}" {{#unless editable}}disabled{{/unless}}/></label><label>{{localize "FASTNRI.Fields.quantity"}}<input type="text" inputmode="decimal" data-dtype="Number" class="fnri-number" name="system.quantity" value="{{system.quantity}}" {{#unless editable}}disabled{{/unless}}/></label><label>{{localize "FASTNRI.Fields.charges"}}<input type="text" inputmode="decimal" data-dtype="Number" class="fnri-number" name="system.charges" value="{{system.charges}}" {{#unless editable}}disabled{{/unless}}/></label></div>{{/if}}
{{#if isAbility}}<div class="fnri-grid-2"><label>{{localize "FASTNRI.Fields.category"}}<input name="system.category" value="{{system.category}}" {{#unless editable}}disabled{{/unless}}/></label><label>{{localize "FASTNRI.Fields.cost"}}<input name="system.cost" value="{{system.cost}}" {{#unless editable}}disabled{{/unless}}/></label><label>{{localize "FASTNRI.Fields.trigger"}}<input name="system.trigger" value="{{system.trigger}}" {{#unless editable}}disabled{{/unless}}/></label><label>{{localize "FASTNRI.Fields.frequency"}}<input name="system.frequency" value="{{system.frequency}}" {{#unless editable}}disabled{{/unless}}/></label></div><label>{{localize "FASTNRI.Fields.effect"}}<textarea name="system.effect" rows="3" {{#unless editable}}disabled{{/unless}}>{{system.effect}}</textarea></label>{{/if}}
<label>{{localize "FASTNRI.Fields.tags"}}<input name="system.tags" value="{{system.tags}}" {{#unless editable}}disabled{{/unless}}/></label></section>
<section class="fnri-panel"><h3>{{localize "FASTNRI.Sections.description"}}</h3><textarea name="system.description" rows="5" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea></section>
<section class="fnri-panel"><h3>{{localize "FASTNRI.Sections.notes"}}</h3><textarea name="system.notes" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></section></section>