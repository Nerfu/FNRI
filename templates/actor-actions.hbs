<div class="fnri-tab-content" data-fnri-panel="actions" {{#unless tabs.actions}}hidden{{/unless}}>
<section class="fnri-panel fnri-attacks"><h3>{{localize "FASTNRI.Equipment.attacks"}}</h3>
  <div class="fnri-attack-slots">
  {{#each attackHands}}
    <div class="fnri-attack-slot" {{#if this.id}}data-item-id="{{this.id}}"{{/if}}>
      <strong class="fnri-slot-name">{{this.label}}</strong>
      <span class="fnri-attack-information"><span class="fnri-slot-occupant">{{#if this.name}}{{this.name}}{{else}}—{{/if}}</span>{{#if this.details}}<small class="fnri-attack-details">{{this.details}}</small>{{/if}}</span>
      {{#if this.damageSummary}}<span class="fnri-attack-profile">{{this.damageSummary}}</span>{{/if}}
      {{#if this.gripWarning}}<small class="fnri-grip-warning" title="{{localize 'FASTNRI.Equipment.secondHandRequired'}}" aria-label="{{localize 'FASTNRI.Equipment.secondHandRequired'}}"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></small>{{/if}}{{#if this.canAttack}}<button type="button" data-action="attackEquipped" title="{{localize 'FASTNRI.Weapon.attack'}}"><i class="fa-solid fa-dice-d20"></i></button>{{/if}}
    </div>
  {{/each}}
    <div class="fnri-attack-slot fnri-unarmed-row">
      <strong class="fnri-slot-name">{{localize "FASTNRI.Equipment.unarmedSlot"}}</strong>
      <span class="fnri-attack-information">
      {{#if unarmedAction.hasChoices}}
      <details class="fnri-unarmed-picker">
        <summary class="fnri-slot-occupant" title="{{localize 'FASTNRI.Equipment.chooseUnarmed'}}">{{unarmedAction.name}}</summary>
        <div class="fnri-unarmed-options" role="group" aria-label="{{localize 'FASTNRI.Equipment.chooseUnarmed'}}">
          {{#each unarmedAction.choices}}
            <button type="button" class="fnri-unarmed-option {{#if this.selected}}fnri-unarmed-selected{{/if}}" data-action="selectUnarmedAttack" data-unarmed-choice="{{this.key}}" {{#unless @root.editable}}disabled{{/unless}} aria-pressed="{{#if this.selected}}true{{else}}false{{/if}}">
              <span>{{this.name}}</span>{{#if this.selected}}<i class="fa-solid fa-check" aria-hidden="true"></i>{{/if}}
            </button>
          {{/each}}
        </div>
      </details>
      {{else}}<span class="fnri-slot-occupant">{{unarmedAction.name}}</span>{{/if}}
      {{#if unarmedAction.details}}<small class="fnri-attack-details">{{unarmedAction.details}}</small>{{/if}}
      </span>
      {{#if unarmedAction.damageSummary}}<span class="fnri-attack-profile">{{unarmedAction.damageSummary}}</span>{{/if}}
      {{#if unarmedAction.freeHandWarning}}<small class="fnri-grip-warning" title="{{localize 'FASTNRI.Equipment.freeHandRequired'}}" aria-label="{{localize 'FASTNRI.Equipment.freeHandRequired'}}"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></small>{{/if}}
      <button type="button" data-action="attackUnarmed" title="{{localize 'FASTNRI.Weapon.attack'}}"><i class="fa-solid fa-dice-d20"></i></button>
    </div>
  {{#if hasOtherAttacks}}<div class="fnri-other-attacks"><strong>{{localize "FASTNRI.Equipment.other"}}</strong>
    {{#each otherAttacks}}<div class="fnri-attack-slot" data-item-id="{{this.id}}"><span class="fnri-attack-information"><span class="fnri-slot-occupant">{{this.name}}</span>{{#if this.details}}<small class="fnri-attack-details">{{this.details}}</small>{{/if}}</span>
      {{#if this.damageSummary}}<span class="fnri-attack-profile">{{this.damageSummary}}</span>{{/if}}
      {{#if this.canAttack}}<button type="button" data-action="attackEquipped" title="{{localize 'FASTNRI.Weapon.attack'}}"><i class="fa-solid fa-dice-d20"></i></button>{{/if}}</div>{{/each}}
  </div>{{/if}}
  </div>
</section>

{{#each actionSections}}
<section class="fnri-panel">
  <h3>{{this.title}}</h3>
  <ul class="fnri-sheet-actions">
  {{#each this.cards}}{{> fnri-actor-standard-action}}{{/each}}
  </ul>
</section>
{{/each}}
</div>
